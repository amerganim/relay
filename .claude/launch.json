{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "relay-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "relay-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:relay"
      ],
      "port": 5174
    },
    {
      "name": "relay-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "relay"
      ],
      "port": 8787
    }
  ]
}
